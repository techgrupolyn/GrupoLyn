PORT=3003
BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/superagente

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=REEMPLAZA_CON_LA_CLAVE_DE_EVOLUTION
INSTANCE_NAME=lyn-local
WEBHOOK_URL=http://localhost:3003/webhook/evolution
PUBLIC_APP_URL=http://localhost:3003
WEBHOOK_SECRET=reemplaza-por-un-secreto-webhook-largo-y-aleatorio
CEO_INITIAL_PASSWORD=elige-una-clave-segura
# Opcional: crea la cuenta Público limitada exclusivamente a Consultas IA.
CEO_PUBLIC_INITIAL_PASSWORD=
CEO_SESSION_SECRET=reemplaza-este-secreto-por-uno-largo-y-aleatorio
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5175,http://localhost:5175
# Producción: ID de la extensión publicada en Chrome Web Store.
CHROME_EXTENSION_IDS=

# Google Drive / Google Meet (opcional, solo lectura)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3003/api/integrations/google-drive/oauth/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_SYNC_MAX_FILES=1000
# Revisa automáticamente las carpetas activas para importar reuniones nuevas o modificadas.
GOOGLE_DRIVE_SYNC_INTERVAL_MS=60000
GOOGLE_DRIVE_TEXT_MAX_CHARS=200000
PROTOCOL_ASSIGNMENTS_SHEET_ID=
# Carpeta anterior de Protocolos de Club LYN; vacía hasta validar corpus y permisos.
PROTOCOL_LEGACY_DRIVE_FOLDER_ID=
# IDs de documentos heredados revisados y aptos para todos los usuarios internos, separados por comas.
PROTOCOL_LEGACY_DRIVE_FILE_IDS=
# Integración privada con el widget de Club LYN; desactivada hasta completar QA.
PROTOCOL_CLUB_ENABLED=false
CROSS_SSO_CLUB_TO_AGENT_TOKEN=

# Directorio corporativo de Supabase (opcional, solo lectura desde este backend)
# Usa una clave server-side existente; nunca uses esta clave en frontend ni extensión.
SUPABASE_SOURCE_URL=
SUPABASE_SOURCE_SECRET_KEY=
SUPABASE_AUTH_ENABLED=false
# Solo desarrollo local: omite la activación de la extensión para hosts loopback. Nunca usar en producción.
ALLOW_UNAUTHENTICATED_LOCAL_EXTENSION=false
SUPABASE_SYNC_ENABLED=false
SUPABASE_SYNC_INTERVAL_MS=300000
# Google Gemini (opcional, requerido para IA)
GOOGLE_GEMINI_API_KEY=TU_API_KEY_DE_GOOGLE_AI_STUDIO
GOOGLE_GEMINI_FLASH_MODEL=gemini-3.6-flash
GOOGLE_GEMINI_PRO_MODEL=gemini-3.6-flash

# Sincronización
SYNC_INTERVAL_MS=15000
FULL_SYNC_INTERVAL_MS=300000
AUTO_CLASSIFY_MESSAGES=false
# Usa false solo en vistas previas locales para impedir sincronización y análisis automáticos.
EVOLUTION_BACKGROUND_SYNC_ENABLED=true
MEETING_AI_BACKGROUND_ANALYSIS_ENABLED=true
GEMINI_THINKING_LEVEL=low
MAX_MEDIA_ANALYSIS_ITEMS=3
MAX_MEDIA_ANALYSIS_BYTES=20971520

# Netelip: llamadas con aviso, grabación y transcripción (opcional).
# Pruebas en local con Linphone: docs/NETELIP_PRUEBAS_LOCALES_LINPHONE.md
NETELIP_WEBHOOK_TOKEN=
NETELIP_TRUSTED_NETWORKS=185.8.244.0/24,192.99.91.144/29
# Extensiones cuyas llamadas se registran todas (aunque no se contesten ni se graben), p. ej. 115.
NETELIP_REGISTRO_EXTENSIONES=
NETELIP_AVISO_TEXT=
NETELIP_AVISO_VOICE=Silvia
NETELIP_AVISO_FILE=
NETELIP_AVISO_ANNOUNCE=
NETELIP_CONTROL_DEFAULT_EXTENSION=
NETELIP_OUTBOUND_CALLERID=
# Número propio por extensión en salientes, JSON {"109":"Grupo LYN;34XXXXXXXXX"}. Sin entrada, NETELIP_OUTBOUND_CALLERID
NETELIP_OUTBOUND_CALLERIDS=
# none | gemini | local_whisper (ver docs/NETELIP_LLAMADAS.md › Transcripción)
NETELIP_TRANSCRIPTION_ENGINE=
NETELIP_WHISPER_COMMAND=
# Minutos que puede tardar Whisper con una llamada antes de cortarlo (30 por defecto, máximo 1440)
NETELIP_WHISPER_TIMEOUT_MINUTES=
NETELIP_DEBUG_AUDIO_DIR=
NETELIP_VDRIVE_USER=
NETELIP_VDRIVE_APP_PASSWORD=

# Calificador interno de llamadas (opcional). Ver docs/NETELIP_LLAMADAS.md › «Calificador interno de llamadas».
# Usa GOOGLE_GEMINI_API_KEY; sin ella no evalúa. CALIFICADOR_ENABLED=false lo apaga.
CALIFICADOR_ENABLED=
CALIFICADOR_MODEL=
CALIFICADOR_THINKING_LEVEL=low
# whatsapp: envía el feedback desde el WhatsApp de la instancia de Evolution. Vacío: solo Dashboard.
CALIFICADOR_ENVIO=
CALIFICADOR_SUPERVISOR_NOMBRE=
CALIFICADOR_SUPERVISOR_WHATSAPP=
CALIFICADOR_DASHBOARD_URL=
CALIFICADOR_SUPERVISOR_ROLES=

# Documento del entrenador de llamadas: publicación del .docx en Google Drive (opcional).
# Con la carpeta definida se pide además el permiso drive.file. Ver docs/NETELIP_LLAMADAS.md.
ENTRENADOR_DRIVE_CARPETA=
ENTRENADOR_DRIVE_CUENTA=

# Panel de marketing (869fny1et). Ver docs/PANEL_MARKETING.md. Sin claves, el panel abre vacío.
WINDSOR_API_KEY=
# Opcionales: cuentas de Windsor (número de la cuenta publicitaria, sin prefijo) y Google Ads cuando se conecte.
MARKETING_WINDSOR_META_ACCOUNTS=
MARKETING_WINDSOR_GOOGLE=
MARKETING_WINDSOR_GOOGLE_ACCOUNTS=
# Token de ClickUp con lectura de la lista de leads («Contacto de Reforma») y el id de esa lista (obligatorio).
CLICKUP_API_TOKEN=
MARKETING_CLICKUP_LIST=
# Sal del hash de los leads. Cambiarla vuelve a crear todos los leads (se pierde la letra de entrada).
MARKETING_HASH_SALT=
# Hora de Madrid de la carga diaria (6 por defecto). false apaga la carga.
MARKETING_CARGA_HORA=
MARKETING_CARGA_ENABLED=
# Roles separados por comas. Para que Ernesto vea la nota comercial, añade su rol a MARKETING_NOTA_ROLES.
MARKETING_ACCESS_ROLES=
MARKETING_NOTA_ROLES=
MARKETING_EDIT_ROLES=
