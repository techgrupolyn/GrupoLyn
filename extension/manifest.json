{
  "manifest_version": 3,
  "name": "LYN Superagente",
  "version": "1.0.5",
  "description": "Asistente interno para analizar chats grupales de WhatsApp Web y preparar resúmenes y respuestas con IA.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://ceo.grupolyn.com/*",
    "https://web.whatsapp.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://ceo.grupolyn.com;",
    "service_worker": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "LYN Superagente",
    "default_icon": {
      "16": "scripts/icons/icon16.png",
      "48": "scripts/icons/icon48.png",
      "128": "scripts/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "scripts/icons/icon16.png",
    "48": "scripts/icons/icon48.png",
    "128": "scripts/icons/icon128.png"
  }
}
