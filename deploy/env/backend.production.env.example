NODE_ENV=production
PORT=3003
BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://lyn_app:REEMPLAZA_PASSWORD@127.0.0.1:5432/superagente

EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=REEMPLAZA_CON_CLAVE_LARGA
INSTANCE_NAME=lyn-production
WEBHOOK_URL=https://app.example.com/webhook/evolution
PUBLIC_APP_URL=https://app.example.com
WEBHOOK_SECRET=REEMPLAZA_CON_SECRETO_LARGO_ALEATORIO

CEO_INITIAL_PASSWORD=REEMPLAZA_CON_CLAVE_INICIAL_SEGURA
# Opcional: crea la cuenta Público limitada exclusivamente a Consultas IA.
CEO_PUBLIC_INITIAL_PASSWORD=
CEO_SESSION_SECRET=REEMPLAZA_CON_SECRETO_LARGO_ALEATORIO
CEO_SESSION_TTL_MS=28800000
CORS_ALLOWED_ORIGINS=https://app.example.com
CHROME_EXTENSION_IDS=REEMPLAZA_CON_EL_ID_DE_CHROME_WEB_STORE
ALLOW_UNAUTHENTICATED_LOCAL_EXTENSION=false

# Google Drive / Google Meet (opcional, solo lectura)
GOOGLE_DRIVE_CLIENT_ID=REEMPLAZA_CON_CLIENT_ID_OAUTH
GOOGLE_DRIVE_CLIENT_SECRET=REEMPLAZA_CON_CLIENT_SECRET_OAUTH
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://app.example.com/api/integrations/google-drive/oauth/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=REEMPLAZA_CON_64_CARACTERES_HEXADECIMALES
GOOGLE_DRIVE_SYNC_PAGE_SIZE=1000
# Revisa automáticamente las carpetas activas para importar reuniones nuevas o modificadas.
GOOGLE_DRIVE_SYNC_INTERVAL_MS=60000
GOOGLE_DRIVE_TEXT_MAX_CHARS=200000

# Agente de Protocolos: activar solo tras validar la carpeta y el juego de preguntas.
PROTOCOL_AGENT_ENABLED=false
# UUID de una conexión OAuth de Drive que pueda leer la subcarpeta Protocolos de Alex.
PROTOCOL_DRIVE_CONNECTION_ID=
PROTOCOL_MAX_TOKENS=100000
PROTOCOL_PYTHON_BIN=python3
PROTOCOL_MODEL=gemini-3.5-flash-lite
PROTOCOL_VISION_MODEL=gemini-3.5-flash-lite
PROTOCOL_SHEET_MAX_ROWS=500

# Directorio corporativo de Supabase (solo lectura desde backend; jamás publicar esta clave)
SUPABASE_SOURCE_URL=https://supabase.example.com
SUPABASE_SOURCE_SECRET_KEY=REEMPLAZA_CON_CLAVE_SERVER_SIDE
SUPABASE_AUTH_ENABLED=true
CLUB_LYN_SSO_ORIGIN=https://club-lyn.grupolyn.com
DASHBOARD_SSO_ORIGIN=https://ceo.grupolyn.com
SUPABASE_SYNC_ENABLED=true
SUPABASE_SYNC_INTERVAL_MS=300000
MEETING_PROJECT_MATCHING_ENABLED=false
CLUB_PHONE_EVIDENCE_ENABLED=false
CLUB_PHONE_EVIDENCE_TOKEN=
CLUB_PHONE_EVIDENCE_ACCOUNT_IDS=

GOOGLE_GEMINI_API_KEY=REEMPLAZA_CON_CLAVE_GEMINI
GOOGLE_GEMINI_FLASH_MODEL=gemini-3.6-flash
GOOGLE_GEMINI_PRO_MODEL=gemini-3.6-flash

# Calificador · reuniones de Meet de los closers (869fppbcj). Todo opcional; ver docs/REUNIONES_MEET_CALIFICADOR.md.
# Sin rúbricas de closer activas no se llama al modelo. Valores entre comillas: deploy.sh carga este archivo con source.
# REUNIONES_MEET_ENABLED=false          # apaga ingesta, vinculación y evaluación (la migración se aplica igual al arrancar)
# REUNIONES_MEET_EVALUAR=false          # apaga solo la evaluación con Gemini
# REUNIONES_MEET_INVITADOS=false        # apaga la consulta de invitados a Calendar
# Lead en ClickUp «Contacto de Reforma» (solo lectura). Token de una cuenta con acceso de solo lectura a esa lista.
# CLICKUP_API_TOKEN="pk_…"
# Etapas de ETAPA_CRM → fase de la reunión (por defecto solo e4:F2).
# REUNIONES_MEET_ETAPAS="e4:F2"
# Coste en dinero del informe (precio por millón de tokens de GOOGLE_GEMINI_FLASH_MODEL); sin ellos, solo tokens.
# CALIFICADOR_PRECIO_ENTRADA_1M=
# CALIFICADOR_PRECIO_SALIDA_1M=

# Captación · WhatsApp automático cuando un lead entra en «e1 EN ESPERA». Ver docs/CAPTACION_WHATSAPP_ESPERA.md.
# Apagado por defecto: sin CAPTACION_WHATSAPP_ENABLED=true no se escribe a ningún lead. Usa CLICKUP_API_TOKEN (arriba).
# CAPTACION_WHATSAPP_ENABLED=true
# CAPTACION_CLICKUP_WEBHOOK_SECRET="…"           # webhook.secret que devuelve el alta del webhook de ClickUp
# WHATSAPP_CLOUD_TOKEN="EAA…"                    # token de usuario del sistema con whatsapp_business_messaging
# Remitente según «Presupuesto formulario»: desde 100.000 € Ernesto, por debajo Victor. phone_number_id de cada uno.
# CAPTACION_WHATSAPP_REMITENTE_ALTO_NUMERO_ID="…"   # Ernesto
# CAPTACION_WHATSAPP_REMITENTE_BASE_NUMERO_ID="…"   # Victor
# CAPTACION_WHATSAPP_UMBRAL_PRESUPUESTO=100000
# WHATSAPP_CLOUD_PHONE_NUMBER_ID="…"             # opcional: número común para quien no tenga uno propio
# WHATSAPP_CLOUD_APP_SECRET="…"                  # firma de los webhooks de estado de Meta
# WHATSAPP_CLOUD_VERIFY_TOKEN="…"                # cadena aleatoria; la misma en la configuración del webhook en Meta
# CAPTACION_WHATSAPP_PLANTILLA="aviso_solicitud_llamada"   # nombre de la plantilla APROBADA
# CAPTACION_WHATSAPP_IDIOMA="es_ES"
# CAPTACION_WHATSAPP_HORARIO="07:00-20:00"       # Jean: nunca entre las 20:00 y las 07:00 (hora de Madrid)
# CAPTACION_WHATSAPP_SOLO_TELEFONOS="+34…"      # SOLO durante el QA: escribe únicamente a estos móviles; vaciar al pasar a real
# CAPTACION_WHATSAPP_CADUCIDAD_MINUTOS=720       # un aviso más antiguo ya no se envía
# CAPTACION_BARRIDO_MINUTOS=5

SYNC_INTERVAL_MS=15000
FULL_SYNC_INTERVAL_MS=300000
SUMMARY_HISTORY_MAX_CHARS=45000
PENDING_CONTEXT_MESSAGE_LIMIT=200
AUTO_CLASSIFY_MESSAGES=false
GEMINI_THINKING_LEVEL=low
MAX_MEDIA_ANALYSIS_ITEMS=3
MAX_MEDIA_ANALYSIS_BYTES=20971520
