NODE_ENV=production
PORT=3003
BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://lyn_app:REEMPLAZA_PASSWORD@127.0.0.1:5432/superagente

EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=REEMPLAZA_CON_CLAVE_LARGA
INSTANCE_NAME=lyn-production
WEBHOOK_URL=https://app.example.com/webhook/evolution
PUBLIC_APP_URL=https://app.example.com
WEBHOOK_SECRET=REEMPLAZA_CON_SECRETO_LARGO_ALEATORIO

CEO_INITIAL_PASSWORD=REEMPLAZA_CON_CLAVE_INICIAL_SEGURA
# Opcional: crea la cuenta Público limitada exclusivamente a Consultas IA.
CEO_PUBLIC_INITIAL_PASSWORD=
CEO_SESSION_SECRET=REEMPLAZA_CON_SECRETO_LARGO_ALEATORIO
CEO_SESSION_TTL_MS=28800000
CORS_ALLOWED_ORIGINS=https://app.example.com
CHROME_EXTENSION_IDS=REEMPLAZA_CON_EL_ID_DE_CHROME_WEB_STORE

# Google Drive / Google Meet (opcional, solo lectura)
GOOGLE_DRIVE_CLIENT_ID=REEMPLAZA_CON_CLIENT_ID_OAUTH
GOOGLE_DRIVE_CLIENT_SECRET=REEMPLAZA_CON_CLIENT_SECRET_OAUTH
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://app.example.com/api/integrations/google-drive/oauth/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=REEMPLAZA_CON_64_CARACTERES_HEXADECIMALES
GOOGLE_DRIVE_SYNC_MAX_FILES=1000
# Revisa automáticamente las carpetas activas para importar reuniones nuevas o modificadas.
GOOGLE_DRIVE_SYNC_INTERVAL_MS=60000
GOOGLE_DRIVE_TEXT_MAX_CHARS=200000

# Directorio corporativo de Supabase (solo lectura desde backend; jamás publicar esta clave)
SUPABASE_SOURCE_URL=https://supabase.example.com
SUPABASE_SOURCE_SECRET_KEY=REEMPLAZA_CON_CLAVE_SERVER_SIDE
SUPABASE_SYNC_ENABLED=true
SUPABASE_SYNC_INTERVAL_MS=300000

GOOGLE_GEMINI_API_KEY=REEMPLAZA_CON_CLAVE_GEMINI
GOOGLE_GEMINI_FLASH_MODEL=gemini-3.6-flash
GOOGLE_GEMINI_PRO_MODEL=gemini-3.6-flash

SYNC_INTERVAL_MS=15000
FULL_SYNC_INTERVAL_MS=300000
SUMMARY_HISTORY_MAX_CHARS=45000
PENDING_CONTEXT_MESSAGE_LIMIT=200
AUTO_CLASSIFY_MESSAGES=false
GEMINI_THINKING_LEVEL=low
MAX_MEDIA_ANALYSIS_ITEMS=3
MAX_MEDIA_ANALYSIS_BYTES=20971520
