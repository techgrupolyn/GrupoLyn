NODE_ENV=production
PORT=__BACKEND_PORT__
BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://lyn_app___INSTANCE__:REEMPLAZA_PASSWORD_APP@127.0.0.1:5432/superagente___INSTANCE__

EVOLUTION_API_URL=http://127.0.0.1:__EVOLUTION_PORT__
EVOLUTION_API_KEY=REEMPLAZA_CON_LA_MISMA_CLAVE_DE_EVOLUTION
INSTANCE_NAME=__INSTANCE__
WEBHOOK_URL=https://__DOMAIN__/webhook/evolution
PUBLIC_APP_URL=https://__DOMAIN__
WEBHOOK_SECRET=REEMPLAZA_CON_SECRETO_WEBHOOK_UNICO

CEO_INITIAL_PASSWORD=REEMPLAZA_CON_LA_CLAVE_INICIAL_DEL_CEO
# Opcional: crea la cuenta Público limitada exclusivamente a Consultas IA.
CEO_PUBLIC_INITIAL_PASSWORD=
CEO_SESSION_SECRET=REEMPLAZA_CON_SECRETO_DE_SESION_UNICO
CEO_SESSION_TTL_MS=28800000
CORS_ALLOWED_ORIGINS=https://__DOMAIN__
CHROME_EXTENSION_IDS=REEMPLAZA_CON_EL_ID_DE_CHROME_WEB_STORE

GOOGLE_GEMINI_API_KEY=REEMPLAZA_CON_LA_CLAVE_GEMINI
GOOGLE_GEMINI_FLASH_MODEL=gemini-3.6-flash
GOOGLE_GEMINI_PRO_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low

SYNC_INTERVAL_MS=15000
FULL_SYNC_INTERVAL_MS=300000
SUMMARY_HISTORY_MAX_CHARS=45000
PENDING_CONTEXT_MESSAGE_LIMIT=200
AUTO_CLASSIFY_MESSAGES=false
MAX_MEDIA_ANALYSIS_ITEMS=3
MAX_MEDIA_ANALYSIS_BYTES=20971520
